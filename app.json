{
  "expo": {
    "name": "Mangaka",
    "slug": "goctruyentranhvui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logonen.png",
    "scheme": "goctruyentranhvui",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logonen.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logonen.png",
        "backgroundColor": "#0D0D0F"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "package": "com.anonymous.goctruyentranhvui"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logonen.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0F",
          "dark": {
            "image": "./assets/images/logonen.png",
            "imageWidth": 400,
            "resizeMode": "contain",
            "backgroundColor": "#0D0D0F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
